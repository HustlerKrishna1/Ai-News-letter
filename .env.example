# ---- LLM provider ----
# One of: anthropic | openai | mock   (mock = offline deterministic output)
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=2500

# ---- Data ingestion ----
# NewsAPI (optional — leave blank to use RSS / HN / Reddit / arXiv / GitHub only).
NEWSAPI_KEY=
NEWSAPI_QUERY=(AI OR "artificial intelligence") OR economy OR capitalism OR geopolitics OR startup
NEWSAPI_LANGUAGE=en
NEWSAPI_PAGE_SIZE=40

# Comma-separated RSS feed URLs. Leave blank to use built-in defaults.
RSS_FEEDS=

# Hacker News (no key required)
HN_ENABLED=true
HN_TOP_COUNT=30
HN_MIN_SCORE=50

# Reddit (no key required, uses public JSON endpoints)
REDDIT_ENABLED=true
REDDIT_SUBS=technology,artificial,singularity,MachineLearning,worldnews,Economics,stocks,geopolitics
REDDIT_MIN_SCORE=100
REDDIT_PER_SUB=10

# arXiv (fresh research papers; no key required)
ARXIV_ENABLED=true
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL
ARXIV_MAX_RESULTS=25

# GitHub Trending (today's hottest open-source repos)
GITHUB_TRENDING_ENABLED=true
GITHUB_TRENDING_LANGUAGES=,python,typescript
GITHUB_TRENDING_PER_LANG=8
GITHUB_TRENDING_SINCE=daily

MAX_ARTICLES_PER_SOURCE=15
MAX_TOTAL_ARTICLES=40
HTTP_TIMEOUT=15

# ---- Enrichment ----
# Fetch full article text for the top-N ranked items before writing sections.
ENRICH_ENABLED=true
ENRICH_TOP_N=15

# ---- Cross-run dedup ----
# Skip articles already featured in an issue within the last N days.
CROSS_RUN_DEDUP=true
CROSS_RUN_DEDUP_DAYS=14

# ---- Editorial pipeline ----
EDITORIAL_PICK_LIMIT=15
EDITORIAL_PARALLEL_SECTIONS=4
CRITIQUE_ENABLED=true
# Regenerate the draft if the critique scores it below this overall (0-10).
CRITIQUE_REGENERATE_BELOW=6.0

# ---- Output ----
EMIT_HTML=true

# ---- Email delivery (optional; used with --deliver email) ----
# One of: smtp | sendgrid | ""   (leave blank to disable email entirely)
EMAIL_PROVIDER=
EMAIL_FROM=
# Comma-separated list of recipients
EMAIL_TO=
EMAIL_SUBJECT_PREFIX=Signal Brief

# SMTP (e.g., Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=

# ---- Chat delivery (optional; used with --deliver slack|discord|telegram) ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated default channel list: any of email,slack,discord,telegram.
# Used when --deliver is not passed on the CLI. Leave blank for file-only.
DELIVERY_CHANNELS=

# Public base URL of the dashboard (for RSS <link> + delivery CTAs).
# e.g., https://brief.example.com
PUBLIC_BASE_URL=

# ---- Observability ----
# One of: text | json   (json is one object per line, for Datadog / Loki / ELK)
LOG_FORMAT=text

# ---- Web UI ----
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
