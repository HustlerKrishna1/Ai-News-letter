# ---- LLM provider ----
# One of: anthropic | openai | mock   (mock = offline deterministic output)
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=2500

# ---- Data ingestion ----
# Optional — leave blank to use RSS only.
NEWSAPI_KEY=
NEWSAPI_QUERY=(AI OR "artificial intelligence") OR economy OR capitalism OR geopolitics OR startup
NEWSAPI_LANGUAGE=en
NEWSAPI_PAGE_SIZE=40

# Comma-separated RSS feed URLs. Leave blank to use built-in defaults.
RSS_FEEDS=

# Hacker News (no key required)
HN_ENABLED=true
HN_TOP_COUNT=30
HN_MIN_SCORE=50

# Reddit (no key required, uses public JSON endpoints)
REDDIT_ENABLED=true
REDDIT_SUBS=technology,artificial,singularity,MachineLearning,worldnews,Economics,stocks,geopolitics
REDDIT_MIN_SCORE=100
REDDIT_PER_SUB=10

MAX_ARTICLES_PER_SOURCE=15
MAX_TOTAL_ARTICLES=40
HTTP_TIMEOUT=15

# ---- Output ----
EMIT_HTML=true

# ---- Email delivery (optional, used with `python main.py --email`) ----
# One of: smtp | sendgrid | ""   (leave blank to disable email entirely)
EMAIL_PROVIDER=
EMAIL_FROM=
# Comma-separated list of recipients
EMAIL_TO=
EMAIL_SUBJECT_PREFIX=Signal Brief

# SMTP (e.g., Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=

# ---- Web UI ----
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
