<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body{font-family:-apple-system,Segoe UI,Roboto,Helvetica,sans-serif;max-width:680px;
       margin:0 auto;padding:2rem 1rem;line-height:1.55;color:#1a1a1a;background:#fafafa}
  .card{background:#fff;padding:1.5rem 2rem;border-radius:10px;
        box-shadow:0 1px 3px rgba(0,0,0,.06)}
  h1{font-size:1.6rem;margin:0 0 .3rem;border-bottom:2px solid #222;padding-bottom:.4rem}
  h2{font-size:1.2rem;margin-top:2rem;color:#222}
  h3{font-size:1rem;color:#444}
  .meta{color:#666;font-size:.85rem;margin-bottom:1.2rem}
  a{color:#0366d6;text-decoration:none}a:hover{text-decoration:underline}
  hr{border:none;border-top:1px solid #eee;margin:1.5rem 0}
  em{color:#555}
  ul{padding-left:1.2rem}
  li{margin-bottom:.3rem}
  .footer{text-align:center;color:#888;font-size:.8rem;margin-top:2rem}
  .clusters{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0 1.2rem}
  .cluster-pill{background:#f0f3f7;color:#224;font-size:.75rem;
               padding:.15rem .55rem;border-radius:999px}
  .critique{background:#fafcff;border-left:3px solid #d0d9e6;padding:.4rem .8rem;
            font-size:.8rem;color:#556;margin-top:1rem}
</style></head><body>
<div class="card">
  <h1>{{ title }}</h1>
  <div class="meta">
    <em>AI · Economy · Capitalism · Power Shifts</em> · {{ date }}
    {% if provider %}· <code>{{ provider }}</code>{% endif %}
  </div>

  {% if clusters %}
  <div class="clusters">
    {% for c in clusters %}
      <span class="cluster-pill">{{ c.name }} ({{ c.count }})</span>
    {% endfor %}
  </div>
  {% endif %}

  {{ body_html | safe }}

  {% if critique and critique.overall %}
  <div class="critique">
    Internal quality score: {{ critique.overall }}/10
    {%- if critique.scores %}
      (faithful {{ critique.scores.faithfulness or '–' }},
       clear {{ critique.scores.clarity or '–' }},
       specific {{ critique.scores.specificity or '–' }},
       restrained {{ critique.scores.restraint or '–' }})
    {%- endif %}
  </div>
  {% endif %}

  <hr />
  <h2>Sources</h2>
  <ol>
    {% for a in articles %}
      <li><a href="{{ a.url }}">{{ a.title }}</a> — <em>{{ a.source }}</em></li>
    {% endfor %}
  </ol>
</div>
<div class="footer">Generated by <a href="https://github.com/HustlerKrishna1/Ai-News-letter">newsletter-ai</a></div>
</body></html>
