<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>Search — Newsletter AI</title>
<style>
  body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;max-width:900px;
       margin:0 auto;padding:2rem 1rem;color:#1a1a1a;background:#fafafa}
  h1{border-bottom:2px solid #222;padding-bottom:.3rem}
  table{border-collapse:collapse;width:100%;margin-top:1rem;background:#fff;
        border:1px solid #e4e6ea;border-radius:8px;overflow:hidden}
  th,td{text-align:left;padding:.5rem .75rem;border-bottom:1px solid #eee;
        font-size:.9rem;vertical-align:top}
  th{background:#f6f7f9;font-weight:600}
  input[type=text]{padding:.45rem .6rem;font-size:.95rem;
                   border:1px solid #ddd;border-radius:6px;width:100%;max-width:380px}
  button{padding:.5rem 1rem;cursor:pointer}
  a{color:#0366d6;text-decoration:none}a:hover{text-decoration:underline}
  .pill{display:inline-block;padding:.05rem .45rem;border-radius:999px;
        background:#eef;color:#224;font-size:.7rem}
  .muted{color:#777;font-size:.85rem}
</style></head><body>

<h1>Search archive</h1>
<p><a href="/">← Back to dashboard</a></p>

<form method="get" action="/search">
  <input type="text" name="q" value="{{ q }}" placeholder="title or summary…" autofocus />
  <button type="submit">Search</button>
</form>

<p class="muted">{{ results|length }} match{{ 'es' if results|length != 1 else '' }}{% if q %} for <code>{{ q }}</code>{% endif %}</p>

<table>
  <thead><tr><th>Title</th><th>Source</th><th>Featured In</th><th>Seen</th></tr></thead>
  <tbody>
  {% for r in results %}
    <tr>
      <td><a href="{{ r.url }}">{{ r.title }}</a></td>
      <td>{{ r.source }}</td>
      <td>{% if r.featured_in %}<span class="pill">{{ r.featured_in }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
      <td>{{ r.seen_count }}×</td>
    </tr>
  {% else %}
    <tr><td colspan="4"><em>{% if q %}No matches.{% else %}Enter a query to search.{% endif %}</em></td></tr>
  {% endfor %}
  </tbody>
</table>

</body></html>
